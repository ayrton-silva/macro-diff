datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client"
    output   = "./generated/prisma"
}

model Summoner {
    id              String           @id
    gameName        String
    tagLine         String
    summonerLeagues SummonerLeague[]
    level           Int
    revisionDate    String
    profileIconId   Int
    region          String
    participants    Participant[]
}

model SummonerLeague {
    id           String   @id
    queueType    String
    tier         String
    rank         String
    summoner     Summoner @relation(fields: [summonerId], references: [id])
    summonerId   String
    leaguePoints Int
    wins         Int
    losses       Int
    veteran      Boolean
    inactive     Boolean
    freshBlood   Boolean
    hotStreak    Boolean
}

model Match {
    matchId          String         @id
    gameDuration     Int
    gameEndTimestamp String
    gameMode         String
    gameType         String
    platformId       String
    queueId          Int
    participants     Participant[]
    matchTimeline    MatchTimeline?
}

model MatchTimeline {
    matchTimelineId   String              @id
    matchId           String              @unique
    match             Match               @relation(fields: [matchId], references: [matchId])
    events            Events[]
    participantFrames ParticipantFrames[]
}

model Events {
    eventId                 Int           @id @default(autoincrement())
    timestamp               Int
    type                    String
    creatorId               String?
    wardType                String?
    itemId                  Int?
    afterId                 Int?
    beforeId                Int?
    participantPuuid        String?
    teamId                  Int?
    buildingType            String?
    laneType                String?
    towerType               String?
    victimId                String?
    assistingParticipantIds String[]
    killerId                String?
    killType                String?
    multiKillLength         Int?
    positionx               Int?
    positiony               Int?
    monsterSubType          String?
    monsterType             String?
    matchTimeline           MatchTimeline @relation(fields: [matchTimelineId], references: [matchTimelineId])
    matchTimelineId         String
}

model ParticipantFrames {
    id                         Int           @id @default(autoincrement())
    participantFrameId         Int
    participantPuuid           String
    timestamp                  Int
    positionx                  Int
    positiony                  Int
    level                      Int
    jungleMinionsKilled        Int
    minionsKilled              Int
    totalGold                  Int
    currentGold                Int
    health                     Int
    healthMax                  Int
    power                      Int
    powerMax                   Int
    abilityPower               Int
    attackDamage               Int
    xp                         Int
    totalDamageDoneToChampions Int
    matchTimeline              MatchTimeline @relation(fields: [matchTimelineId], references: [matchTimelineId])
    matchTimelineId            String
}

model Participant {
    summonerId                  String
    matchId                     String
    summoner                    Summoner @relation(fields: [summonerId], references: [id])
    match                       Match    @relation(fields: [matchId], references: [matchId])
    championName                String
    champLevel                  Int
    assists                     Int
    deaths                      Int
    kills                       Int
    lane                        String
    teamPosition                String
    summoner1Id                 Int
    summoner2Id                 Int
    totalMinionsKilled          Int
    neutralMinionsKilled        Int
    totalDamageDealtToChampions Int
    wardsPlaced                 Int
    goldEarned                  Int
    item0                       Int
    item1                       Int
    item2                       Int
    item3                       Int
    item4                       Int
    item5                       Int
    item6                       Int
    perksStat0                  Int
    perksStat1                  Int
    perksStat2                  Int
    perksPrimaryStyle           Int
    perksPrimaryStyleSelection0 Int
    perksPrimaryStyleSelection1 Int
    perksPrimaryStyleSelection2 Int
    perksPrimaryStyleSelection3 Int
    perksSubStyle               Int
    perksSubStyleSelection0     Int
    perksSubStyleSelection1     Int
    teamId                      String
    win                         Boolean

    @@id(name: "participantId", [summonerId, matchId])
}
